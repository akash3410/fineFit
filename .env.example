# Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
DJANGO_SETTINGS_MODULE=config.settings.local
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
# IMPORTANT: Percent-encode special characters in USER and PASSWORD, otherwise
# the URL parses incorrectly and connections fail (or silently use a truncated
# password). In particular '@' must be written as '%40'.
# Example password 'pass@word' -> 'pass%40word'.
DATABASE_URL=postgres://finefit_user:finefit_password@127.0.0.1:5432/finefit_db

# Explicit CORS & CSRF Origins (Vite Local Dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
